{
  "description": "Prose column beside a scrolling image column",
  "id": "about",
  "name": "About",
  "type": "SharedSlice",
  "variations": [
    {
      "description": "Default",
      "docURL": "...",
      "id": "default",
      "imageUrl": "",
      "items": {},
      "name": "Default",
      "primary": {
        "surface": {
          "config": {
            "default_value": "blush",
            "label": "Surface",
            "options": [
              "blush",
              "ink"
            ],
            "placeholder": "Background this section sits on"
          },
          "type": "Select"
        },
        "paragraphs": {
          "config": {
            "fields": {
              "text": {
                "config": {
                  "label": "Text",
                  "placeholder": "One paragraph of the about story",
                  "single": "paragraph,strong,em,hyperlink"
                },
                "type": "StructuredText"
              }
            },
            "label": "Paragraphs"
          },
          "type": "Group"
        },
        "images": {
          "config": {
            "fields": {
              "image": {
                "config": {
                  "constraint": {
                    "height": 1440,
                    "width": 1080
                  },
                  "label": "Image",
                  "placeholder": "Portrait crop, roughly 3:4",
                  "thumbnails": []
                },
                "type": "Image"
              }
            },
            "label": "Images"
          },
          "type": "Group"
        }
      },
      "version": "initial"
    }
  ]
}